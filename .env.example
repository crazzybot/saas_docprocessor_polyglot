# Settings are read from `.env` in the working directory: copy this file to
# the repository root (`just dev` runs both services from there), or export
# them in your shell. Values below target Azurite + the Service Bus emulator +
# PostgreSQL started by `just deps`.

# --- Azure access -----------------------------------------------------------
# Production (AKS): set these and leave the connection strings unset; the
# services authenticate with Entra ID (Workload Identity / DefaultAzureCredential).
# STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# SERVICE_BUS_NAMESPACE=<namespace>.servicebus.windows.net

# Local development fallback (used only when the two settings above are unset).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

BLOB_CONTAINER_NAME=raw-documents
RESULTS_CONTAINER_NAME=extraction-results
SERVICE_BUS_QUEUE_NAME=extraction-jobs
SERVICE_BUS_RESULTS_TOPIC_NAME=extraction-results

# --- Document service (TypeScript): events + catalog -----------------------
SERVICE_BUS_EVENTS_TOPIC_NAME=document-events
SERVICE_BUS_RESULTS_SUBSCRIPTION_NAME=document-service
# Local Postgres from `just deps` (use POSTGRES_HOST_PORT if you remapped it).
# In Azure: no password, plus POSTGRES_ENTRA_AUTH=true.
DATABASE_URL=postgresql://docprocessor:docprocessor@127.0.0.1:5432/docprocessor
POSTGRES_ENTRA_AUTH=false
DB_RUN_MIGRATIONS=true
TOMBSTONE_RETENTION_HOURS=168

# --- Document service (TypeScript): auth ------------------------------------
# Never disable auth outside local development.
AUTH_ENABLED=false
AZURE_AD_AUDIENCE=api://saas-docprocessor
# Comma-separated Entra ID tenant IDs of onboarded customers.
AZURE_AD_ALLOWED_TENANT_IDS=
AZURE_AD_REQUIRED_SCOPE=Documents.Upload
MAX_UPLOAD_SIZE_MB=25
PORT=8000

# --- Worker (Python) --------------------------------------------------------
MAX_CONCURRENCY=4
PREFETCH_COUNT=0
MAX_DELIVERY_ATTEMPTS=3
MAX_LOCK_RENEWAL_SECONDS=600
PROCESSING_TIMEOUT_SECONDS=300
METRICS_PORT=9100
HEALTH_PORT=8080

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
AZURE_SDK_LOG_LEVEL=WARNING
# Unset => the document service doesn't export spans (OTEL_TRACES_EXPORTER=console
# prints them) and the worker prints them to the console.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
