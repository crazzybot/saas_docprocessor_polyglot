{
  "name": "saas-docprocessor-polyglot",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript projects of the polyglot monorepo (the Python ones are a uv workspace).",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p libs/ts-shared/test && tsc -p services/document-service/test",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.9",
    "rust-just": "^1.57.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
