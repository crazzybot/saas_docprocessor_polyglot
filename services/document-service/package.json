{
  "name": "@docprocessor/document-service",
  "version": "2.0.0",
  "private": true,
  "description": "Document API (upload, catalog, content) for the SaaS document processing platform.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/copy-assets.mjs src/adapters/postgres/migrations dist/adapters/postgres/migrations",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -b && tsc -p test/tsconfig.json"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.34.0",
    "@docprocessor/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@opentelemetry/api": "^1.9.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@azure/core-rest-pipeline": "^1.25.0",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
